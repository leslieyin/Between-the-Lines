# ─────────────────────────────────────────────────────────────
# 话外音 · 环境变量样例
# 复制为 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略）。
# 所有变量在 src/server/config.ts 集中校验，缺失或非法会立刻报错，不会带病运行。
#
# 这个文件只影响本地 `npm run dev`。线上的运行时变量来自 Cloudflare，
# 改这里不会影响线上，反之亦然。
#
# 部署到 Cloudflare 时，密钥有两条路，二选一：
#   A) 填在下面的 TYPESAFE_API_KEY，`npm run deploy` 会自动上传成 Worker secret
#   B) 留空，改在 Cloudflare 控制台配：
#      Worker → Settings → Variables and Secrets → Runtime variables and secrets
#      → 添加 TYPESAFE_API_KEY（类型 Secret）。改完即生效，不用重新部署。
#   注意：A 会把文件里的值覆盖控制台那份；想让控制台说了算，就把这里留空。
# 其余非敏感项（模型名、上限、限流）来自 wrangler.jsonc 的 vars。
# ─────────────────────────────────────────────────────────────

# 【必填·二选一】TypeSafe API Key。只在服务端使用，绝不会出现在浏览器产物里。
# 申请入口：https://typesafe.ai
TYPESAFE_API_KEY=ts_live_xxxxxxxxxxxxxxxxxxxxxxxx

# 【可选】Jev 模型别名，默认 jev-latest
TYPESAFE_MODEL=jev-latest

# 【可选】TypeSafe 接口地址，一般无需修改
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1

# 【可选】演示模式。true 时不调用真实 Jev，用内置样例输出跑通全链路界面。
# 没有 Key、或用完额度想先看效果时打开它。
DEMO_MODE=false

# 【可选】输入与分析规模上限，防滥用
ANALYZE_MAX_CHARS=8000        # 单次粘贴的最大字符数
ANALYZE_MAX_LINES=40          # 单次允许的最大行数
ANALYZE_MAX_ANALYZED_LINES=16 # 实际送去翻牌的最大句数（控制耗时与成本）
ANALYZE_GROUP_SIZE=4          # 每个 Jev 请求里合并几句（越大越快越省，但单次判断更挤）

# 【可选】每台设备每小时允许发起的分析次数
RATE_LIMIT_PER_HOUR=20

# 【可选】单次 Jev 请求超时（毫秒）
TYPESAFE_TIMEOUT_MS=60000
